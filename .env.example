# RepoLens AI — Environment Variables

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Application secret key (change in production — generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# GitHub Personal Access Token (optional — increases API rate limits from 60 to 5000 req/hour)
GITHUB_TOKEN=

# Application settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Session settings
SESSION_MAX_AGE=86400

# Analysis settings
MAX_FILES_TO_ANALYZE=50
MAX_FILE_SIZE_KB=100
